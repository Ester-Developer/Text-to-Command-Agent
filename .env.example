# Free API key from https://aistudio.google.com/apikey (Google AI Studio - Gemini)
# Copy this file to .env and fill in your key
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: model override. gemini-flash-lite-latest has the highest free-tier
# daily quota; gemini-3.6-flash is stronger but capped at ~20 free requests/day.
GEMINI_MODEL=gemini-flash-lite-latest
